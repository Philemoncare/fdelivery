# OmniMarket environment configuration
# Copy to .env and fill in real values. NEVER commit real credentials.

# ---- App ----
# Public URL used as the base for links inside emails
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Mail (single centralized sender) ----
# Master switch. Keep "false" locally to capture emails instead of sending.
MAIL_ENABLED="false"

# The single "from" address all OmniMarket emails come from.
MAIL_FROM_EMAIL="omnimarket.gh@gmail.com"
MAIN_FROM_NAME="OmniMarket Ghana"
MAIL_FROM_NAME="OmniMarket Ghana"

# SMTP transport (Gmail app password required — not your Gmail login password).
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="omnimarket.gh@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Optional capture endpoint (e.g. Mailtrap/smtp4dev) for development.
# MAIL_INSPECTOR_URL=""

# ---- Secrets ----
# Any long random string. Used to sign auth tokens.
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Optional integrations ----
# GEMINI_API_KEY=""