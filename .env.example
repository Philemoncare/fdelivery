# OmniMarket environment configuration
# Copy to .env and fill in real values. NEVER commit real credentials.

# ---- App ----
# Public URL used as the base for links inside emails
APP_URL="http://localhost:3003"
NODE_ENV="development"

# ---- Mail (single centralized sender) ----
# Master switch. Keep "false" locally to capture emails instead of sending.
MAIL_ENABLED="false"

# The single "from" address all OmniMarket emails come from.
MAIL_FROM_EMAIL="omnimarket.gh@gmail.com"
MAIN_FROM_NAME="OmniMarket Ghana"
MAIL_FROM_NAME="OmniMarket Ghana"

# SMTP transport (Gmail app password required — not your Gmail login password).
# Create one at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="omnimarket.gh@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"

# Optional capture endpoint (e.g. Mailtrap/smtp4dev) for development.
# MAIL_INSPECTOR_URL=""

# ---- Secrets ----
# Any long random string. Used to sign auth tokens. Do NOT reuse the known
# development fallback value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Database ----
# The dev API persists to omnimarket-db.json automatically. PostgreSQL is the
# production target (see database/schema.sql); when a DB-backed adapter is wired
# up, set the connection string here.
# DATABASE_URL="postgres://user:password@localhost:5432/omnimarket"

# ---- Payments ----
# Gateway credentials. Until a provider is configured the server runs in
# dev-auto-verify mode (orders are only treated as paid after the server
# confirms payment; no real money moves). Required before going live.
# Paystack secret key (https://dashboard.paystack.com)
# PAYSTACK_SECRET_KEY="sk_live_..."
# MTN Mobile Money (HUBTEL) API client credentials
# HUBTEL_CLIENT_ID=""
# HUBTEL_CLIENT_SECRET=""
# Hubtel merchant account / number
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=""
# HUBTEL_API_KEY=""

# ---- Maps / GPS ----
# Used by rider navigation and address autocomplete. Not required for basic
# delivery tracking (the server stores raw lat/lng coordinates).
# GOOGLE_MAPS_API_KEY=""
# MAPBOX_ACCESS_TOKEN=""

# ---- OAuth / social login ----
# Google and Apple sign-in. Until credentials are provided the login buttons
# show a clear "not configured" message instead of failing silently.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3003/api/auth/oauth/callback?provider=google"
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""

# ---- SMS (announcements / OTP over phone) ----
# SMS_SENDER_ID="OMNIMARKET"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
